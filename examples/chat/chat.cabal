cabal-version:      3.0
name:               chat
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
-- author:
-- maintainer:
-- copyright:
category:           Chat
build-type:         Simple
-- extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common shared-properties
    ghc-options:
                      -Wall
                      -O2
                      -- -fno-warn-type-defaults
                      -- -fno-warn-unused-matches
                      -- -fno-warn-unused-do-bind
                      -- -Werror=missing-methods
                      -- -Werror=incomplete-patterns
                      -- -fno-warn-unused-binds
                      -threaded
                      -rtsopts
                      "-with-rtsopts=-N4 -A256m -AL256m -I0"


    default-language: Haskell2010

    default-extensions:
                      ApplicativeDo
                    , BangPatterns
                    , BlockArguments
                    , ConstraintKinds
                    , DataKinds
                    , DeriveDataTypeable
                    , DeriveGeneric
                    , DerivingStrategies
                    , DerivingVia
                    , ExtendedDefaultRules
                    , FlexibleContexts
                    , FlexibleInstances
                    , GADTs
                    , GeneralizedNewtypeDeriving
                    , ImportQualifiedPost
                    , LambdaCase
                    , MultiParamTypeClasses
                    , OverloadedLabels
                    , OverloadedStrings
                    , QuasiQuotes
                    , RankNTypes
                    , RecordWildCards
                    , ScopedTypeVariables
                    , StandaloneDeriving
                    , TupleSections
                    , TypeApplications
                    , TypeFamilies
                    , TypeOperators
                    , ViewPatterns

executable chat
    import:         shared-properties

    hs-source-dirs: src
    main-is:        Main.hs

    other-modules:  Components.Head
                  , Components.Icons
                  , Components.LogoutButton
                  , Components.MenuButton
                  , Components.Skeleton
                  , Components.ThemeToggleButton
                  , Components.WSConnectionStatus
                  , Config
                  , DB
                  , Env
                  , Error
                  , Log
                  , Message
                  , Monad
                  , Pages.Login
                  , Pages.Main
                  , Types
                  , Util.Lucid.Attributes
                  , Util.Lucid.Elements
                  , Util.Text
                  , Util.UserNameColor
                  , Workers
                  , Workers.DownloadQueue
                  , Workers.RefChan
                  , Workers.Web

    build-depends:  base
                  , aeson
                  , attoparsec
                  , bytestring
                  , containers
                  , db-pipe
                  , directory
                  , filepath
                  , hashable
                  , hbs2-core
                  , hbs2-keyman-direct-lib
                  , hbs2-peer
                  , http-types
                  , interpolatedstring-perl6
                  , lucid
                  , microlens-mtl
                  , mtl
                  , prettyprinter
                  , prettyprinter-ansi-terminal
                  , saltine
                  , scotty
                  , serialise
                  , sqlite-simple
                  , streaming
                  , suckless-conf
                  , text
                  , time
                  , transformers
                  , unliftio
                  , unliftio-core
                  , unordered-containers
                  , uuid
                  , wai
                  , wai-extra
                  , wai-middleware-static
                  , wai-websockets
                  , warp
                  , websockets